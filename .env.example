# ==============================================================
# Autonomous AI Class Representative (CR) Assistant - Config
# ==============================================================

# AI Providers (At least one provider recommended)
# Google Gemini (Multimodal Vision + Reasoning): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq LPU (Ultra Fast Inference): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_PRIMARY_PROVIDER=groq

# Class Representative / Admin Identity
ADMIN_NAME=Your Full Name
ADMIN_PHONE=8801XXXXXXXXX
ADMIN_STUDENT_ID=00000000
ADMIN_EMAIL=your_email@example.com
UNIVERSITY_NAME=Your University Name
DEPARTMENT_NAME=Computer Science & Engineering
BATCH_NAME=1st
SECTION_NAME=A

# Security & Web Dashboard Access
DASHBOARD_PASSWORD=change_this_dashboard_password
SECRET_KEY=change_this_to_a_random_secure_secret_key

# Google Sheets Configuration (For Routine, Changes, Faculty, CRs)
# Publish or share your Google Sheet as CSV
GOOGLE_SHEET_ID=
GID_ROUTINE=
GID_CHANGES=
GID_FACULTY=
GID_CRS=

# WhatsApp Bridge Configuration
WHATSAPP_PORT=3001
WHATSAPP_HOST=127.0.0.1
WHATSAPP_BRIDGE_URL=http://localhost:3001
WHATSAPP_NOTICE_GROUP_ID=https://chat.whatsapp.com/YOUR_INVITE_CODE

# Messenger Bridge Configuration (Optional)
MESSENGER_CR_GROUP_URL=https://www.facebook.com/messages/t/YOUR_THREAD_ID
MESSENGER_CR_THREAD_ID=YOUR_THREAD_ID
MESSENGER_AUTO_RELAY=true

# Student Portal Scraper (Optional)
STUDENT_PORTAL_URL=https://portal.example.edu/Login
STUDENT_PORTAL_USER=
STUDENT_PORTAL_PASS=

# Automated Schedule
DAILY_ROUTINE_HOUR=6
DAILY_ROUTINE_MINUTE=0
SHEET_POLL_INTERVAL_SECONDS=300

# Server Host and Port
APP_HOST=0.0.0.0
APP_PORT=8000
